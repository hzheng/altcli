{
  "name": "altcli-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "kb": "node scripts/build-kb.mjs",
    "predev": "npm run kb",
    "dev": "node --experimental-strip-types server.ts --dev",
    "prebuild": "npm run kb",
    "build": "next build",
    "start": "node --experimental-strip-types server.ts",
    "pretypecheck": "npm run kb",
    "typecheck": "next typegen && tsc --noEmit",
    "test:terminal": "node --experimental-strip-types --test scripts/terminal-input.test.ts",
    "test:smoke": "node --experimental-strip-types --test scripts/smoke.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pree2e": "npm run kb",
    "e2e": "playwright test",
    "check": "npm run test:global-ai && npm run typecheck && npm run test:smoke && npm run test:workflow && npm test && npm run build",
    "check:e2e": "npm run check && npm run e2e",
    "test:workflow": "node --experimental-strip-types --test scripts/workflow.test.ts scripts/implementation.test.ts scripts/planning.test.ts scripts/projects.test.ts scripts/finish.test.ts scripts/terminal-broker.test.ts scripts/launch-cleanup.test.ts scripts/attachments.test.ts scripts/registry.test.ts scripts/attention.test.ts",
    "postinstall": "node scripts/prepare-pty.mjs",
    "probe:terminal": "node --experimental-strip-types --test scripts/native-terminal.test.ts",
    "probe:terminal:http": "node scripts/terminal-http-probe.mjs",
    "test:native": "node --experimental-strip-types --test scripts/native-terminal.test.ts scripts/native-launch.test.ts scripts/native-reconcile.test.ts scripts/native-global-ai.test.ts",
    "probe:terminal:writers": "node --expose-gc --experimental-strip-types --test scripts/native-writers.test.ts",
    "probe:terminal:ws": "node scripts/terminal-websocket-probe.mjs",
    "pretest:global-ai": "npm run kb",
    "test:global-ai": "node --experimental-strip-types --test scripts/global-ai.test.ts scripts/global-ai.integration.test.ts",
    "upgrade:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/upgrade-check.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.11.1",
    "next": "16.3.4",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
