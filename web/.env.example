# Run `node scripts/setup.mjs` at the repository root to generate .env.local and a token.
# Never set this token in NEXT_PUBLIC_*; it must stay server-side.
ALTCLI_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN
# tmux is the default. "mock" is a test adapter with simulated panes; it never touches a terminal.
ALTCLI_ADAPTER=tmux
# Set to false for a read-only console (captures only, no Send or Relay).
ALTCLI_ENABLE_INPUT=true
# Native browser terminals (xterm.js attached to tmux). Take keyboard is host-shell power for the token holder.
# Remote use needs a proxy that forwards WebSocket upgrades. Omitting the line means false.
ALTCLI_ENABLE_TERMINAL=true
# Explicitly previewed launches of saved executable+argument profiles into chosen checkouts. Omitting the line means false.
ALTCLI_ENABLE_AGENT_LAUNCH=true
# Deprecated staging fallback; committed implementation is the default.
ALTCLI_ENABLE_LEGACY_RELAY=false
# Integration branches: starting points for task branches/worktrees, never implementation branches.
# The repository's default branch (origin/HEAD) is always included.
ALTCLI_INTEGRATION_BRANCHES=main,master
ALTCLI_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
# Optional absolute directory, outside AltCLI and every managed worktree.
# Default: ~/.local/share/altcli (separate mock/ and tmux/ stores).
# ALTCLI_DATA_DIR=/Users/hui/.local/share/altcli
# Optional tmux binary or socket path; no shell fragments.
# ALTCLI_TMUX_BIN=/opt/homebrew/bin/tmux
# ALTCLI_TMUX_SOCKET=/absolute/path/to/tmux/socket
