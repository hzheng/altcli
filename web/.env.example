# Run `node scripts/setup.mjs` at the repository root to generate .env.local and a token.
# Never set this token in NEXT_PUBLIC_*; it must stay server-side.
CODERCREW_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN
# tmux is the default. "mock" is a test adapter with simulated panes; it never touches a terminal.
CODERCREW_ADAPTER=tmux
# Set to false for a read-only console (captures only, no Send or Relay).
CODERCREW_ENABLE_INPUT=true
# Deprecated staging fallback; committed implementation is the default.
CODERCREW_ENABLE_LEGACY_RELAY=false
# Integration branches: starting points for task branches/worktrees, never implementation branches.
# The repository's default branch (origin/HEAD) is always included.
CODERCREW_INTEGRATION_BRANCHES=main,master
CODERCREW_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
# Optional absolute directory, outside CoderCrew and every managed worktree.
# Default: ~/.local/share/codercrew (separate mock/ and tmux/ stores).
# CODERCREW_DATA_DIR=/Users/hui/.local/share/codercrew
# Optional tmux binary or socket path; no shell fragments.
# CODERCREW_TMUX_BIN=/opt/homebrew/bin/tmux
# CODERCREW_TMUX_SOCKET=/absolute/path/to/tmux/socket
